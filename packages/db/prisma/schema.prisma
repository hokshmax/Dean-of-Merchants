// Eldorado: AI-generated clothing designs, printed and shipped on demand in-house.

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Design {
  id        String   @id @default(cuid())
  prompt    String
  imageUrl  String
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id                           String   @id @default(cuid())
  designId                     String
  design                       Design   @relation(fields: [designId], references: [id])
  size                         String
  color                        String   @default("Black")
  quantity                     Int      @default(1)
  retailPriceAmountMinorUnits  Int
  currency                     String
  // Collected up front, before the payment redirect -- Tap's hosted page only handles payment,
  // not shipping details, unlike Stripe Checkout.
  recipientEmail                String?
  shippingName                 String?
  shippingLine1                String?
  shippingLine2                String?
  shippingCity                 String?
  shippingRegion               String?
  shippingPostalCode           String?
  shippingCountryCode          String?
  // PENDING_PAYMENT | PAID | IN_PRODUCTION | SHIPPED | CANCELED -- fulfillment is in-house and
  // manual, driven from the admin dashboard, not an external POD API.
  status                       String   @default("PENDING_PAYMENT")
  // Tap Payments charge id (e.g. "chg_..."). Generic name since it's no longer Stripe-specific.
  paymentReference             String?  @unique
  trackingCarrier              String?
  trackingNumber               String?
  trackingUrl                  String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@index([designId])
}
