// Eldorado: AI-generated clothing designs, printed and shipped on demand via Printful.

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Design {
  id        String   @id @default(cuid())
  prompt    String
  imageUrl  String
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id                           String   @id @default(cuid())
  designId                     String
  design                       Design   @relation(fields: [designId], references: [id])
  variantId                    Int
  quantity                     Int      @default(1)
  retailPriceAmountMinorUnits  Int
  currency                     String
  // Unknown until Stripe Checkout completes -- Stripe's hosted page collects this itself, so
  // the app never needs its own email/shipping form before starting checkout.
  recipientEmail                String?
  shippingName                 String?
  shippingLine1                String?
  shippingLine2                String?
  shippingCity                 String?
  shippingRegion                String?
  shippingPostalCode           String?
  shippingCountryCode          String?
  // PENDING_PAYMENT | PAID | SUBMITTED_TO_PRINTFUL | FULFILLMENT_FAILED | IN_PRODUCTION | SHIPPED | CANCELED
  status                       String   @default("PENDING_PAYMENT")
  stripeCheckoutSessionId      String?  @unique
  printfulOrderId              String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@index([designId])
}
