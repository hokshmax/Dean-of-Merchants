# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dean_of_merchants"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# AI provider: which model powers the chat assistant. "claude" or "gemini".
AI_PROVIDER="claude"

# Anthropic (Claude API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Google Gemini (used only when AI_PROVIDER="gemini")
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Payments
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# Platform
PLATFORM_FEE_RATE="0.025"

# App
API_PORT="3001"
WEB_PORT="3000"
NODE_ENV="development"
