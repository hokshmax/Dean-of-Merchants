# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dean_of_merchants"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# AI provider for chat: which model powers the design conversation. "claude" or "gemini".
AI_PROVIDER="claude"

# Anthropic (Claude API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Google Gemini -- used for chat when AI_PROVIDER="gemini", and ALWAYS used for AI image
# generation (Imagen) regardless of the chat provider, since Imagen is Google-only.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
IMAGEN_MODEL="imagen-4.0-generate-001"

# Where generated design images are stored and served from. API_PUBLIC_URL must be a real
# internet-reachable address (not "localhost") for Printful to be able to fetch the design file
# when placing an order -- see README.
DESIGN_STORAGE_DIR="./data/designs"
API_PUBLIC_URL="http://localhost:3001"
WEB_PUBLIC_URL="http://localhost:3000"

# Printful (print-on-demand fulfillment). Free private API token:
# Printful account -> Settings -> Stores -> API.
PRINTFUL_API_KEY=""
PRINTFUL_TSHIRT_PRODUCT_ID="71"

# Stripe (checkout + payment). Test-mode keys are fine for development.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Margin charged on top of Printful's base cost -- this is the entire revenue model.
MARGIN_RATE="0.5"

# App
API_PORT="3001"
WEB_PORT="3000"
NODE_ENV="development"
