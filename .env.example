# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dean_of_merchants"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# AI provider: which model powers the chat assistant. "claude" or "gemini".
AI_PROVIDER="claude"

# Anthropic (Claude API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Google Gemini (used only when AI_PROVIDER="gemini")
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Payments (not currently used -- the app links out to retailers' own checkout instead of
# processing payment itself; kept for a possible future direct-checkout integration)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# Platform (no fee charged to the user -- revenue is affiliate commission, invisible to them)
PLATFORM_FEE_RATE="0"

# eBay Browse API (free developer keyset: https://developer.ebay.com/my/keys)
EBAY_APP_ID=""
EBAY_CERT_ID=""
# eBay Partner Network campaign ID, for affiliate-tagging offer links (optional)
EBAY_CAMPAIGN_ID=""

# Best Buy Products API (free developer key: https://developer.bestbuy.com)
BESTBUY_API_KEY=""
# Impact.com affiliate link template once approved for the Best Buy Affiliate Program, with
# {URL} as the placeholder for the real product URL (optional)
BESTBUY_AFFILIATE_LINK_TEMPLATE=""

# Walmart, Target, AliExpress, noon, Temu, and Amazon are disabled until their affiliate
# programs are approved and real API integrations are written -- see README for details.

# App
API_PORT="3001"
WEB_PORT="3000"
NODE_ENV="development"
