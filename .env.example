# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dean_of_merchants"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# AI provider for chat: which model powers the design conversation. "claude" or "gemini".
AI_PROVIDER="claude"

# Anthropic (Claude API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Google Gemini -- used for chat when AI_PROVIDER="gemini", and ALWAYS used for AI image
# generation (Imagen) regardless of the chat provider, since Imagen is Google-only.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
IMAGEN_MODEL="imagen-4.0-generate-001"

# Where generated design images are stored and served from, and where Tap's payment webhook
# posts to (${API_PUBLIC_URL}/orders/webhook) -- a real internet-reachable address, not
# "localhost", for both gallery images and payment confirmation to work.
DESIGN_STORAGE_DIR="./data/designs"
API_PUBLIC_URL="http://localhost:3001"
WEB_PUBLIC_URL="http://localhost:3000"

# Tap Payments (checkout + payment) -- covers UAE/Saudi/Kuwait/Bahrain/Oman/Qatar/Jordan/Egypt,
# since Stripe doesn't operate in the Middle East. Secret key from the Tap dashboard
# (Settings -> API Keys); test keys are fine for development.
TAP_SECRET_KEY=""

# Fulfillment is in-house, not an external print-on-demand API. BASE_PRODUCT_COST_MINOR_UNITS is
# your own per-shirt production cost in cents (1500 = $15.00); MARGIN_RATE is charged on top of
# it -- together, this is the entire revenue model.
BASE_PRODUCT_COST_MINOR_UNITS="1500"
MARGIN_RATE="0.5"

# Shared secret for the /admin orders dashboard. Set a long random value; anyone with it can see
# and edit every order.
ADMIN_TOKEN=""

# App
API_PORT="3001"
WEB_PORT="3000"
NODE_ENV="development"
