{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "prisma:generate": {
      "outputs": ["generated/**"]
    },
    "@dean/db#typecheck": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "@dean/db#build": {
      "dependsOn": ["^build", "prisma:generate"]
    }
  }
}
