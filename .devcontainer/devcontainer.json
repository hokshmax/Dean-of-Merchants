{
  "name": "Eldorado",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "onCreateCommand": "sudo corepack enable && sudo corepack prepare pnpm@10.33.0 --activate",
  "postCreateCommand": "docker compose -f infra/docker-compose.yml up -d postgres redis && pnpm install && pnpm --filter @dean/db prisma:generate && pnpm --filter @dean/db prisma:migrate:deploy",

  "containerEnv": {
    "NODE_ENV": "development",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/dean_of_merchants",
    "REDIS_URL": "redis://localhost:6379",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "AI_PROVIDER": "${localEnv:AI_PROVIDER}",
    "TAP_SECRET_KEY": "${localEnv:TAP_SECRET_KEY}",
    "ADMIN_TOKEN": "${localEnv:ADMIN_TOKEN}"
  },

  "forwardPorts": [3000, 3001],
  "portsAttributes": {
    "3000": { "label": "Web (chat UI)", "onAutoForward": "openPreview" },
    "3001": { "label": "API", "onAutoForward": "notify", "visibility": "public" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "Prisma.prisma"]
    }
  }
}
